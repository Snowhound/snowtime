{
  "name": "snowhound-kaitk",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "datamodel": "bun run datamodel:generate && docker compose -f datamodel/docker-compose.yml up -d && echo 'ChartDB: http://localhost:8080 (Import > .json > datamodel/snowtime.chartdb.json)'",
    "datamodel:generate": "bun datamodel/generate-dbml.ts && bun run datamodel:build",
    "datamodel:check": "bun datamodel/generate-dbml.ts --check",
    "datamodel:build": "bun datamodel/dbml-to-chartdb.mjs",
    "datamodel:stop": "docker compose -f datamodel/docker-compose.yml down",
    "db:generate": "bun scripts/db-generate.ts",
    "db:migrate": "bun scripts/db-verify.ts && bunx --bun drizzle-kit migrate",
    "db:verify": "bun scripts/db-verify.ts",
    "db:drift": "bun scripts/db-drift.ts",
    "db:seed": "bun scripts/db-seed.ts",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --silent",
    "icons:check": "bun scripts/icon-names.ts",
    "icons:fix": "bun scripts/icon-names.ts --fix",
    "test": "bun run i18n:compile && bun run icons:check && bun test && vitest run",
    "test:server": "bun test",
    "test:components": "vitest run",
    "postinstall": "bun run i18n:compile"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.5",
    "@fontsource/inter": "^5.1.1",
    "@kobalte/core": "^0.13.14",
    "@libsql/client": "0.18.0",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/solid-form": "latest",
    "@tanstack/solid-query": "latest",
    "@tanstack/solid-query-devtools": "latest",
    "@tanstack/solid-router": "latest",
    "@tanstack/solid-router-devtools": "latest",
    "@tanstack/solid-router-ssr-query": "1.167.3",
    "@tanstack/solid-start": "latest",
    "better-auth": "^1.5.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "lucide-solid": "1.48.0",
    "nitro": "3.0.260610-beta",
    "solid-js": "^1.9.12",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.25.4",
    "@solidjs/testing-library": "0.8.10",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.133.21",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "1.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-solid": "^0.18.0",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
