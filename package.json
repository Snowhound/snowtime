{
  "name": "snowtime",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "build:self-hosted": "bun scripts/build-self-hosted.ts",
    "build:binary": "bun scripts/build-self-hosted.ts --binary",
    "start:self-hosted": "bun scripts/start-self-hosted.ts",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "datamodel": "bun run datamodel:generate && docker compose -f datamodel/docker-compose.yml up -d && echo 'ChartDB: http://localhost:8080 (Import > .json > datamodel/snowtime.chartdb.json)'",
    "datamodel:generate": "bun datamodel/generate-dbml.ts && bun run datamodel:build",
    "datamodel:check": "bun datamodel/generate-dbml.ts --check",
    "datamodel:build": "bun datamodel/dbml-to-chartdb.mjs",
    "datamodel:stop": "docker compose -f datamodel/docker-compose.yml down",
    "env:init": "bun scripts/env-init.ts",
    "db:generate": "bun scripts/db-generate.ts",
    "db:migrate": "bun scripts/db-migrate.ts",
    "db:verify": "bun scripts/db-verify.ts",
    "db:drift": "bun scripts/db-drift.ts",
    "db:seed": "bun scripts/db-seed.ts",
    "db:import": "bun scripts/db-import.ts",
    "holidays:update": "bun scripts/holidays-update.ts",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --silent",
    "icons:check": "bun scripts/icon-names.ts",
    "icons:fix": "bun scripts/icon-names.ts --fix",
    "knip": "knip && knip --directory native/crates/render/bundle/bench",
    "perf": "bun perf/check.ts",
    "perf:load": "bun perf/load.ts",
    "perf:stress": "bun perf/stress/stress.ts",
    "perf:pages": "bun perf/pages.ts",
    "perf:weather": "bun perf/weather.ts",
    "test": "bun run i18n:compile && bun run icons:check && bun test && vitest run",
    "test:server": "bun test",
    "test:components": "vitest run",
    "test:conformance": "bun test ./conformance/*.conformance.ts",
    "postinstall": "bun run i18n:compile",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.6",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@kobalte/core": "^0.13.14",
    "@libsql/client": "0.18.0",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/solid-form": "latest",
    "@tanstack/solid-query": "latest",
    "@tanstack/solid-router": "latest",
    "@tanstack/solid-router-devtools": "latest",
    "@tanstack/solid-router-ssr-query": "1.167.3",
    "@tanstack/solid-start": "1.168.57",
    "@upstash/redis": "^1.39.0",
    "better-auth": "1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.13",
    "lucide-solid": "1.48.0",
    "nitro": "3.0.260903-beta",
    "solid-js": "^1.9.12",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "valibot": "^1.5.0",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.25.4",
    "@solidjs/testing-library": "0.8.10",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-plugin": "1.168.42",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "1.4.2",
    "acorn": "^8.18.0",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-solid": "^0.18.0",
    "fflate": "^0.8.2",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "playwright-core": "^1.63.0",
    "seroval": "1.5.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "5.0.2"
  },
  "packageManager": "bun@1.4.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
