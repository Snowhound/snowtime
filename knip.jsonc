{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Start's server entry (vite.config.ts) and drizzle-kit's config, which knip can't load
  // without TURSO_DATABASE_URL.
  // The compiled release's migrator, which scripts/build-self-hosted.ts compiles by path.
  // The harnesses (perf/README.md); the weather bench's page script loads from its HTML and
  // its config from createServer.
  "entry": [
    "src/server-entry.ts",
    "drizzle.config.ts",
    "scripts/db-migrate-release.ts",
    "perf/*.ts",
    "perf/weather/bench.ts",
    "perf/weather/vite.config.ts",
  ],
  "drizzle": false,
  // Static prototypes and design files load their scripts from HTML.
  "ignore": ["prototypes/**", "design/**"],
  "ignoreIssues": {
    // The Solid-UI copies keep the registry's exports.
    "src/components/ui/**": ["exports", "types"],
  },
}
