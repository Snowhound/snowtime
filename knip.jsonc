{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Start's server entry (vite.config.ts) and drizzle-kit's config, which knip can't load
  // without TURSO_DATABASE_URL.
  // The compiled release's migrator, which scripts/build-self-hosted.ts compiles by path.
  // The harnesses (perf/README.md); the weather bench's page script loads from its HTML and
  // its config from createServer. The load benchmark's k6 scenario runs in k6's container.
  // The native backend's harnesses (native/README.md), including the OAuth fetch preload.
  // Paraglide's Vite plugin and CLI load its config from the project folder.
  "entry": [
    "src/server-entry.ts",
    "drizzle.config.ts",
    "project.inlang/paraglide.config.ts",
    "scripts/db-migrate-release.ts",
    "perf/*.ts",
    "conformance/oauth-preload.ts",
    "perf/weather/bench.ts",
    "perf/weather/vite.config.ts",
    "perf/stress/scenario.js",
    "perf/stress/edge-config.ts",
    "native/bench/**/*.ts",
    "native/crates/render/bundle/*.{ts,tsx,js}",
  ],
  "drizzle": false,
  // Static prototypes and design files load their scripts from HTML.
  // The render benchmark and auth spike each have their own manifest and Knip check.
  "ignore": [
    "prototypes/**",
    "design/**",
    "native/crates/render/bundle/bench/**",
    "native/bench/auth-spike/**",
  ],
  // k6's built-in modules, which the load benchmark's scenario imports inside k6.
  "ignoreDependencies": ["k6"],
  // macOS's GPU counters, which the weather bench reads (perf/weather/gpu-usage.ts).
  "ignoreBinaries": ["ioreg"],
  "ignoreIssues": {
    // The Solid-UI copies keep the registry's exports.
    "src/components/ui/**": ["exports", "types"],
  },
}
