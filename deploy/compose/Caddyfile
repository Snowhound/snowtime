{
	# The admin API stays on localhost:2019 inside the container, which serves the metrics:
	# docker compose exec caddy wget -qO- localhost:2019/metrics
	metrics

	servers {
		# HTTP/3 needs UDP 443 open. Behind Cloudflare's proxy only Cloudflare reaches the
		# origin, over HTTP/1.1 or HTTP/2; HTTP/3 here serves a domain that isn't proxied.
		protocols h1 h2 h3

		# Cloudflare's ranges (https://www.cloudflare.com/ips/, 2026-09-30). Caddy takes the
		# client IP from CF-Connecting-IP only when the request comes from one of them. The
		# load benchmark adds its generator's address (compose.bench.yml).
		trusted_proxies static {$BENCH_TRUSTED_PROXIES} 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# Caddy gets the certificate from Let's Encrypt and redirects HTTP to HTTPS by itself.
{$APP_HOST} {
	# The public files baked into this image, from the same build as the app image.
	root * /srv/snowtime

	# The load benchmark's routes and log (compose.bench.yml); nothing matches otherwise.
	import /etc/caddy/bench/*.caddy

	# Caddy already redacts cookies and Authorization; this drops headers nobody reads.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>tls delete
				resp_headers delete
				request>headers>Sec-Ch-Ua delete
				request>headers>Sec-Ch-Ua-Mobile delete
				request>headers>Sec-Ch-Ua-Platform delete
				request>headers>Sec-Fetch-Site delete
				request>headers>Sec-Fetch-Mode delete
				request>headers>Sec-Fetch-Dest delete
				request>headers>Accept delete
				request>headers>Accept-Language delete
				request>headers>Accept-Encoding delete
				request>headers>Priority delete
				request>headers>Cf-Visitor delete
				request>headers>Cdn-Loop delete
				request>headers>Cf-Ray delete
				request>headers>X-Forwarded-For delete
				request>headers>X-Forwarded-Proto delete
			}
		}
	}

	# Pages and server function responses. Precompressed files keep their encoding; images
	# and fonts aren't compressed again.
	encode zstd gzip {
		minimum_length 1024
	}

	header {
		# No preload: that is a commitment for the whole domain, made on its apex.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Pages carry the app's own policy, with a nonce per page (src/server/csp.server.ts).
		# This one covers every other response, such as an SVG opened on its own.
		?Content-Security-Policy "default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		-Server
	}

	# The build hashes the names in /assets/, so they never change. Files in public/ keep
	# their names and are cached for a week, as vite.config.ts sets for Nitro.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /backgrounds/* Cache-Control "public, max-age=604800"
	header /brand/* Cache-Control "public, max-age=604800"

	# Scanner probes end here instead of rendering the app's not-found page. These handle
	# blocks come first, so they run before the file and app handlers below.
	@bad_methods method TRACE TRACK
	handle @bad_methods {
		respond 405
	}
	@probes {
		path /wp-admin* /wp-login.php /xmlrpc.php /phpmyadmin* /adminer* /cgi-bin*
	}
	@hidden {
		path_regexp (?i)^(?:/\.[^/]+|/.*\.(?:bak|old|sql|zip|tar|gz|tgz|7z))$
		not path /.well-known/*
	}
	handle @probes {
		respond 404
	}
	handle @hidden {
		respond 404
	}

	@file file {path}
	handle @file {
		# The build writes .br, .zst, and .gz beside each text file (bun run build:self-hosted).
		# Brotli at level 11 comes out about 6% smaller than zstd at 19, so it goes first.
		file_server {
			precompressed br zstd gzip
		}
	}

	handle {
		header Cache-Control "private, no-store"
		reverse_proxy app:3000 {
			# While the app restarts, requests wait for it instead of failing with 502.
			lb_try_duration {$BENCH_TRY_DURATION:30s}
			# The load benchmark tries a cap on requests in flight to the app
			# (compose.bench.local.yml); above it, requests wait as during a restart. 0 has none.
			unhealthy_request_count {$BENCH_MAX_REQUESTS:0}
			lb_try_interval 250ms
			# Set from Caddy's client IP, so a request that bypasses Cloudflare can't choose
			# its own address. The app reads it (CLIENT_IP_HEADER=cf-connecting-ip).
			header_up CF-Connecting-IP {client_ip}
		}
	}
}
