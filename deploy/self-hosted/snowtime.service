# The Snowtime app: exactly one process, on 127.0.0.1:3000 behind Caddy
# (docs/deployment/self-hosted.md). Install as /etc/systemd/system/snowtime.service.
[Unit]
Description=Snowtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=snowtime
Group=snowtime

# The compiled release. Built on the server instead, run it with Bun:
#   ExecStart=/usr/local/bin/bun /opt/snowtime/current/server/index.mjs
ExecStart=/opt/snowtime/current/snowtime

# Secrets and settings, owned by root and readable by the snowtime group (mode 0640).
EnvironmentFile=/etc/snowtime/env
Environment=NODE_ENV=production HOST=127.0.0.1 PORT=3000
# The database lives here: TURSO_DATABASE_URL=file:/var/lib/snowtime/snowtime.db.
StateDirectory=snowtime
StateDirectoryMode=0750
WorkingDirectory=/var/lib/snowtime

Restart=on-failure
RestartSec=1
TimeoutStopSec=10
# A leak restarts the app long before the server runs out of memory; it peaks near 500 MB.
MemoryMax=1536M
LimitNOFILE=65536

# Hardening: the process writes only its state directory and reaches only the network.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
# No MemoryDenyWriteExecute: JavaScriptCore's JIT writes executable memory.

[Install]
WantedBy=multi-user.target
