{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "vitest", "promise"],
  "jsPlugins": ["eslint-plugin-solid", "eslint-plugin-regexp"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "warn"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": [
      "error",
      {
        "checksVoidReturn": false
      }
    ],
    "eslint/eqeqeq": ["error", "smart"],
    "regexp/no-contradiction-with-assertion": "error",
    "regexp/no-dupe-disjunctions": "error",
    "regexp/no-empty-alternative": "warn",
    "regexp/no-empty-capturing-group": "error",
    "regexp/no-empty-character-class": "error",
    "regexp/no-empty-group": "error",
    "regexp/no-empty-lookarounds-assertion": "error",
    "regexp/no-misleading-capturing-group": "error",
    "regexp/no-missing-g-flag": "error",
    "regexp/no-potentially-useless-backreference": "warn",
    "regexp/no-super-linear-backtracking": "error",
    "regexp/no-useless-assertions": "error",
    "regexp/no-useless-backreference": "error",
    "eslint/func-style": ["error", "declaration", { "allowTypeAnnotation": true }],
    "solid/components-return-once": "warn",
    "solid/event-handlers": "warn",
    "solid/imports": "warn",
    "solid/jsx-no-duplicate-props": "error",
    "solid/jsx-no-script-url": "error",
    "solid/no-destructure": "error",
    "solid/no-innerhtml": "error",
    "solid/no-react-deps": "warn",
    "solid/no-react-specific-props": "warn",
    "solid/prefer-for": "error",
    "solid/reactivity": "warn",
    "solid/self-closing-comp": "warn",
    "solid/style-prop": "warn",
    "typescript/no-unsafe-type-assertion": "off",
    "unicorn/no-array-sort": "off",
    "eslint/no-shadow": "off",
    "import/no-unassigned-import": "off",
    "vitest/require-mock-type-parameters": "off"
  },
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "src/paraglide/**",
    "drizzle/**",
    "prototypes/**",
    ".output/**"
  ],
  "overrides": [
    {
      "files": [
        "scripts/**",
        "datamodel/**",
        "src/*.{ts,tsx}",
        "src/components/**",
        "src/db/**",
        "src/lib/**",
        "src/routes/**",
        "src/test/**",
        "src/features/*/*.{ts,tsx}",
        "src/server/*.ts"
      ],
      "rules": {
        "import/no-relative-parent-imports": "error"
      }
    },
    {
      "files": ["src/features/*/*/**", "src/server/*/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.\\./\\.\\./",
                "message": "Import from outside this feature or src/server/ through ~/."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "eslint/func-style": "off"
      }
    },
    {
      "files": ["**/*.tsx"],
      "rules": {
        "eslint/no-unassigned-vars": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "typescript/await-thenable": "off",
        "typescript/require-array-sort-compare": "off",
        "unicorn/consistent-function-scoping": "off",
        "solid/reactivity": "off"
      }
    }
  ]
}
