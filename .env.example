# Copy the values you need to .env.local (local) or the Vercel project settings.
# src/env.ts validates them at startup. Keep secrets unprefixed: VITE_ variables reach
# the browser bundle.

# Database. Locally a file (see .env.development); on Vercel a Turso URL and token.
TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
TURSO_AUTH_TOKEN=

# At least 32 characters: bunx --bun @better-auth/cli secret
BETTER_AUTH_SECRET=
# The app's public URL, for example http://localhost:3000
BETTER_AUTH_URL=

# Each OAuth provider is enabled when both its ID and secret are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Restricts Microsoft sign-in to one Entra ID tenant; unset allows any account.
MICROSOFT_TENANT_ID=
